# Скопируйте в .env.local и заполните реальными значениями
# cp .env.example .env.local

# Google OAuth Client ID — обязательно для AdminAuthGate и кнопки Google в регистрации
# Получить: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-client-id

# URL бэкенда (нужен только если фронтенд запускается отдельно вне Docker)
VITE_API_URL=http://localhost:3000
